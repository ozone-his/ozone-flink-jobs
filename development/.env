# Database images
MARIADB_VERSION=10.11
# Host ports, deliberately not the defaults; see docker-compose.yaml.
# Host port bindings. All deliberately off the defaults: this stack is routinely run alongside
# other projects whose Kafka/Postgres/MySQL already own 9092/5432/3306. Container-internal ports
# are unchanged, so in-network addresses (kafka:9092, postgresql:5432) are unaffected.
KAFKA_HOST_PORT=29092
ZOOKEEPER_HOST_PORT=12181
ZOONAVIGATOR_HOST_PORT=18000
CONNECT_HOST_PORT=8383
FLINK_UI_HOST_PORT=18081
KOWL_HOST_PORT=8282
MARIADB_HOST_PORT=13306
POSTGRES_HOST_PORT=15432
POSTGRES_VERSION=16
# MariaDB's own replication server id. Must differ from the Debezium connector's
# database.server.id (37991), which registers as a replica against this server.
MARIADB_SERVER_ID=1

DEBEZIUM_VERSION=1.9
UID=1000
GID=1001
