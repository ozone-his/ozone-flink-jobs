ANALYTICS_DB_USER=analytics
ANALYTICS_DB_PASSWORD=password
ANALYTICS_DB_HOST=postgresql
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=analytics
# The flattening SQL and the analytics migrations live in ozone-analytics-queries (shipped to
# deployments inside the distro). These defaults assume it is cloned beside this repo, which makes
# `docker compose up` work with no further setup; point them at a distro's analytics_config
# instead to run against what a real deployment ships. Relative paths resolve from this directory.
ANALYTICS_SOURCE_TABLES_PATH=../../ozone-analytics-queries/analytics/dsl/flattening/tables
ANALYTICS_QUERIES_PATH=../../ozone-analytics-queries/analytics/dsl/flattening/queries
ANALYTICS_DESTINATION_TABLES_MIGRATIONS_PATH=../../ozone-analytics-queries/analytics/liquibase/analytics
CHANGELOG_FILE=db.changelog-master.xml
ODOO_ANALYTICS_TABLES='databasechangelog,account_account,product_category,sale_order,sale_order_line,res_partner,product_product,product_template,ir_model_data'
FLINK_STATE_BUCKET=flink-state-bucket
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
S3_ENDPOINT_URL=http://minio:9099

#Kafka
# The full set of source-table topics the pipelines subscribe to, one per Flink source
# table DDL. kafka-setup pre-creates these so the streaming job does not fail on a topic
# Debezium has not created yet (it only creates a topic once a table has rows). Keep in
# sync with the source table DDLs; regenerate with:
#   ls ../../ozone-analytics-queries/analytics/dsl/flattening/tables/{openmrs,odoo}/*.sql
CREATE_TOPICS=emr.openmrs.appointment_service,emr.openmrs.appointment_service_type,emr.openmrs.care_setting,emr.openmrs.concept,emr.openmrs.concept_answer,emr.openmrs.concept_name,emr.openmrs.concept_reference_map,emr.openmrs.concept_reference_source,emr.openmrs.concept_reference_term,emr.openmrs.concept_set,emr.openmrs.conditions,emr.openmrs.drug,emr.openmrs.drug_order,emr.openmrs.encounter,emr.openmrs.encounter_diagnosis,emr.openmrs.encounter_type,emr.openmrs.form,emr.openmrs.location,emr.openmrs.location_tag,emr.openmrs.location_tag_map,emr.openmrs.obs,emr.openmrs.order_frequency,emr.openmrs.order_type,emr.openmrs.orders,emr.openmrs.patient,emr.openmrs.patient_appointment,emr.openmrs.patient_appointment_provider,emr.openmrs.patient_identifier,emr.openmrs.patient_identifier_type,emr.openmrs.patient_program,emr.openmrs.person,emr.openmrs.person_address,emr.openmrs.person_attribute,emr.openmrs.person_attribute_type,emr.openmrs.person_name,emr.openmrs.program,emr.openmrs.visit,emr.openmrs.visit_attribute,emr.openmrs.visit_attribute_type,emr.openmrs.visit_type,erp.public.ir_model_data,erp.public.product_product,erp.public.product_template,erp.public.res_partner,erp.public.sale_order,erp.public.sale_order_line

