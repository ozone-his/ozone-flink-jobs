<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.ozonehis</groupId>
  <artifactId>flink-jobs</artifactId>
  <version>3.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>Ozone Analytics ETL</name>
  <description>Flink SQL pipelines that flatten Ozone HIS data for analytics</description>

  <organization>
    <name>Ozone HIS</name>
    <url>https://www.ozone-his.com</url>
  </organization>
  <developers>
    <developer>
      <name>Mekom Solutions</name>
      <url>https://www.mekomsolutions.com</url>
    </developer>
  </developers>

  <distributionManagement>
    <repository>
      <id>mks-nexus-public-releases</id>
      <name>Mekom Solutions Nexus repo for releases</name>
      <url>https://nexus.mekomsolutions.net/repository/maven-releases</url>
    </repository>
    <snapshotRepository>
      <id>mks-nexus-public-snapshots</id>
      <name>Mekom Solutions Nexus repo for snapshots</name>
      <url>https://nexus.mekomsolutions.net/repository/maven-snapshots</url>
    </snapshotRepository>
  </distributionManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- ================================ Java ================================
         `maven.compiler.release` validates against the Java 17 API, so artifacts load on any
         JVM >= 17 (17, 21, 25). Flink supports Java 11/17/21 only (21 experimental, 25 not at
         all), so 17 is both the compile baseline and the runtime we ship.
         https://nightlies.apache.org/flink/flink-docs-stable/docs/deployment/java_compatibility/ -->
    <!-- `release` supersedes `source`/`target`: setting those alongside it is contradictory and
         fails the build. It also validates against the Java 17 API, not just the bytecode level,
         so a Java 21+ method call cannot slip into an artifact that claims to run on 17. -->
    <java.version>17</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>

    <!-- ================================ Flink ===============================
         2.3.0 is the current release. Check availability against the repository's own metadata at
         https://repo1.maven.org/maven2/org/apache/flink/flink-core/maven-metadata.xml, not the
         search.maven.org index: that index lags and under-reports recent releases. -->
    <flink.version>2.3.0</flink.version>

    <!-- Connectors release independently of Flink core, and the trailing `-2.x` is the Flink minor
         they were built against. Neither is current: Kafka's newest is 5.0.0-2.2 and the JDBC
         connector's is 4.0.0-2.0, so both run on a Flink minor they were not built against, which
         is not a combination Apache Flink tests.

         They are used here because the pairing was verified end-to-end rather than assumed: the
         Postgres catalog registers, all 46 source tables resolve, the 12 flattening statements
         submit as one job, a Debezium event flattens through to PostgreSQL, and checkpointing to
         S3 succeeds, with no NoSuchMethodError, NoClassDefFoundError or
         IncompatibleClassChangeError. Re-run that check when bumping any of these versions, and
         prefer a matching connector release the moment one ships. If a pairing ever misbehaves,
         Flink 2.0.2 with JDBC 4.0.0-2.0 and Kafka 4.0.1-2.0 is the exactly matched fallback. -->
    <flink.connector.jdbc.version>4.0.0-2.0</flink.connector.jdbc.version>
    <flink.connector.kafka.version>5.0.0-2.2</flink.connector.kafka.version>

    <!-- Flink is `provided` for the shaded artifact because the cluster image already supplies it;
         bundling it causes classloader conflicts. Overridden to `compile` by the `standalone`
         profile for running a job outside a cluster. -->
    <flink.scope>provided</flink.scope>

    <!-- ========================== Runtime libraries ========================= -->
    <jackson.version>2.18.2</jackson.version>
    <hadoop.version>3.4.1</hadoop.version>
    <postgresql.version>42.7.4</postgresql.version>
    <mysql.connector.version>9.1.0</mysql.connector.version>
    <commons.text.version>1.12.0</commons.text.version>

    <!-- ================================ Logging ============================= -->
    <slf4j.version>2.0.16</slf4j.version>

    <!-- ================================= Test =============================== -->
    <junit.version>5.11.3</junit.version>
    <assertj.version>3.26.3</assertj.version>

    <!-- =============================== Plugins ============================== -->
    <compiler.version>3.13.0</compiler.version>
    <surefire.version>3.5.2</surefire.version>
    <shade.version>3.6.0</shade.version>
    <spotless.version>2.43.0</spotless.version>
    <palantirJavaFormat.version>2.50.0</palantirJavaFormat.version>
  </properties>

  <dependencies>
    <!-- ============================ Flink runtime ===========================
         Supplied by the Flink cluster image at runtime. -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-table-api-java-bridge</artifactId>
      <version>${flink.version}</version>
      <scope>${flink.scope}</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-table-planner-loader</artifactId>
      <version>${flink.version}</version>
      <scope>${flink.scope}</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-table-runtime</artifactId>
      <version>${flink.version}</version>
      <scope>${flink.scope}</scope>
    </dependency>

    <!-- ============================== Connectors ============================
         Bundled into the shaded JAR: the cluster image does not ship these. -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-connector-kafka</artifactId>
      <version>${flink.connector.kafka.version}</version>
    </dependency>
    <!-- The monolithic `flink-connector-jdbc` was split per database at 4.x and has no Flink 2.x
         release. `-core` carries JdbcCatalog; `-postgres` and `-mysql` carry the dialects. -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-connector-jdbc-core</artifactId>
      <version>${flink.connector.jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-connector-jdbc-postgres</artifactId>
      <version>${flink.connector.jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-connector-jdbc-mysql</artifactId>
      <version>${flink.connector.jdbc.version}</version>
    </dependency>

    <!-- ============================== Formats =============================== -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-json</artifactId>
      <version>${flink.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-csv</artifactId>
      <version>${flink.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-parquet</artifactId>
      <version>${flink.version}</version>
    </dependency>
    <!-- flink-parquet writes through parquet-hadoop, which needs Hadoop's Configuration on the
         classpath. Without it the export job fails at runtime with NoClassDefFoundError. Only the
         export pipeline uses it, but the image is shared, so it is bundled here. mapreduce-client
         is excluded down to -core: parquet needs the output-format classes, not a MapReduce
         runtime, and the full client drags in a large transitive tree. -->
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-common</artifactId>
      <version>${hadoop.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-reload4j</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-mapreduce-client-core</artifactId>
      <version>${hadoop.version}</version>
    </dependency>

    <!-- ============================ JDBC drivers ============================ -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>${mysql.connector.version}</version>
    </dependency>

    <!-- ========================= Configuration parsing ====================== -->
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <!-- Provides the ${VAR:-default} substitution used in the configuration file. -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-text</artifactId>
      <version>${commons.text.version}</version>
    </dependency>

    <!-- ================================ Logging ============================= -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
      <scope>${flink.scope}</scope>
    </dependency>

    <!-- ================================= Test ===============================
         The suite is intentionally free of Docker and of private artifacts: the pipelines are pure
         SQL builders, so they are asserted on directly. This keeps the build hermetic and fast. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- No <repositories> block by design. Every dependency resolves from Maven Central, so listing
       the Nexus repos here only made each artifact miss twice before falling back to Central. The
       Nexus coordinates are still needed to *publish*, which is what distributionManagement above
       is for. Keep it that way: a dependency that requires the private Nexus would make the build
       non-hermetic and unbuildable in a cold container. -->

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler.version}</version>
        <configuration>
          <release>${java.version}</release>
          <compilerArgs>
            <arg>-Xlint:all,-serial,-processing</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
      </plugin>
      <!-- One shaded artifact serving every pipeline. The pipeline is chosen by the argument each
           image passes to AnalyticsJob, so it is still fixed at build time, without maintaining a
           near-identical shade execution per pipeline. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${shade.version}</version>
        <executions>
          <execution>
            <id>shade-job</id>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <!-- Signatures from bundled dependencies do not cover the shaded JAR and cause
                       SecurityExceptions if kept. -->
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.ozonehis.analytics.AnalyticsJob</mainClass>
                </transformer>
                <!-- Connectors and JDBC drivers are discovered via ServiceLoader; without this the
                     per-JAR service files overwrite each other and the connectors vanish. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <finalName>${project.artifactId}-${project.version}-etl</finalName>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Bundles Flink itself, for running a pipeline outside a cluster image. -->
    <profile>
      <id>standalone</id>
      <properties>
        <flink.scope>compile</flink.scope>
      </properties>
    </profile>
    <profile>
      <id>spotless</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.diffplug.spotless</groupId>
            <artifactId>spotless-maven-plugin</artifactId>
            <version>${spotless.version}</version>
            <configuration>
              <java>
                <palantirJavaFormat>
                  <version>${palantirJavaFormat.version}</version>
                </palantirJavaFormat>
                <removeUnusedImports/>
                <formatAnnotations/>
              </java>
              <pom>
                <includes>
                  <include>pom.xml</include>
                </includes>
                <sortPom>
                  <encoding>UTF-8</encoding>
                  <expandEmptyElements>false</expandEmptyElements>
                  <predefinedSortOrder>recommended_2008_06</predefinedSortOrder>
                  <sortProperties>false</sortProperties>
                </sortPom>
              </pom>
              <markdown>
                <includes>
                  <include>**/*.md</include>
                </includes>
                <flexmark/>
              </markdown>
            </configuration>
            <executions>
              <execution>
                <id>format</id>
                <goals>
                  <goal>apply</goal>
                  <goal>check</goal>
                </goals>
                <phase>install</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
